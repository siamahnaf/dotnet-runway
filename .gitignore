Runway.App/bin/
Runway.App/obj/
Runway.App/dist/
*.wixpdb
dotnet-runway/node_modules/
*.log

# Shipped artifacts ARE committed, so the repo is usable without a toolchain:
#   Runway-<version>.msi        the installer
#   dotnet-runway-<version>.vsix the extension
