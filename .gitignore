Dotswitch.App/bin/
Dotswitch.App/obj/
Dotswitch.App/dist/
*.wixpdb
dotswitch/node_modules/
*.log

# Shipped artifacts ARE committed, so the repo is usable without a toolchain:
#   Dotswitch-<version>.msi     the installer
#   dotswitch-<version>.vsix    the extension
