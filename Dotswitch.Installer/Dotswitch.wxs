<?xml version="1.0" encoding="utf-8"?>
<!--
  Dotswitch installer.

  Per-machine, fixed location: C:\Program Files\Dotswitch. A predictable path is
  the point — the VS Code extension finds the app by reading the registry key
  written below, rather than guessing or being pointed at a build folder.

  Build with:  wix build Dotswitch.wxs -arch x64 -o Dotswitch-<version>.msi

  -arch x64 is REQUIRED. WiX defaults to x86, which sends the files to
  Program Files (x86) and redirects the registry key into WOW6432Node — where
  the 64-bit VS Code extension cannot see it.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <Package
      Name="Dotswitch"
      Manufacturer="Siam Ahnaf"
      Version="1.1.1"
      UpgradeCode="DE7AB3A5-2305-433B-A500-DEE1D0E2FCBB"
      Scope="perMachine"
      Compressed="yes"
      InstallerVersion="500">

    <!-- Installing a newer build replaces the old one in place, so the fixed
         path never accumulates two copies.

         The UpgradeCode is deliberately the one Runway shipped with: it is what
         makes this build remove an installed Runway rather than leave two
         products, two Start-menu entries and an orphaned C:\Program Files\Runway
         behind. That is also why the version had to climb past 1.0.3 — an
         upgrade only happens if the newcomer is newer. -->
    <MajorUpgrade
        AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of Dotswitch is already installed. Uninstall it first." />

    <MediaTemplate EmbedCab="yes" />

    <Icon Id="DotswitchIcon" SourceFile="..\Dotswitch.App\dotswitch.ico" />

    <!-- What Apps &amp; Features shows. Without these the entry is bare. -->
    <Property Id="ARPPRODUCTICON" Value="DotswitchIcon" />
    <Property Id="ARPNOREPAIR" Value="1" />
    <Property Id="ARPHELPLINK" Value="https://github.com/" />
    <SetProperty Id="ARPINSTALLLOCATION" Value="[INSTALLFOLDER]" After="CostFinalize" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Dotswitch" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ShortcutFolder" Name="Dotswitch" />
    </StandardDirectory>

    <Feature Id="Main" Title="Dotswitch" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="RegistryEntries" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <!-- The published output, harvested wholesale: the exe alone is only a
         launcher and cannot run without its DLLs and wwwroot. -->
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="..\Dotswitch.App\dist\**">
        <!-- Debug symbols have no business in an install. -->
        <Exclude Files="..\Dotswitch.App\dist\*.pdb" />
        <Exclude Files="..\Dotswitch.App\dist\*.xml" />
      </Files>
    </ComponentGroup>

    <!-- How the VS Code extension locates the app.

         New component GUIDs, not Runway's: a component identity is a promise
         about its key path, and these two now point at SOFTWARE\Dotswitch and a
         differently named shortcut. Reusing the old ones would be a component
         rules violation the moment both products were momentarily registered
         during the upgrade. -->
    <Component Id="RegistryEntries" Directory="INSTALLFOLDER"
               Guid="A14A4CF1-E458-4A3F-BE88-AE6AF2862ADE">
      <RegistryKey Root="HKLM" Key="SOFTWARE\Dotswitch">
        <RegistryValue Name="InstallPath" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
        <RegistryValue Name="ExePath" Type="string" Value="[INSTALLFOLDER]Dotswitch.exe" />
        <RegistryValue Name="Version" Type="string" Value="1.1.1" />
      </RegistryKey>
    </Component>

    <Component Id="StartMenuShortcut" Directory="ShortcutFolder"
               Guid="5114A359-F93F-4D0E-9322-1465557A2CD0">
      <Shortcut Id="DotswitchStartMenu"
                Name="Dotswitch"
                Description="Run and manage .NET projects with dotnet watch"
                Target="[INSTALLFOLDER]Dotswitch.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="DotswitchIcon" />
      <RemoveFolder Id="RemoveShortcutFolder" Directory="ShortcutFolder" On="uninstall" />
      <RegistryValue Root="HKLM" Key="SOFTWARE\Dotswitch" Name="StartMenu"
                     Type="integer" Value="1" KeyPath="yes" />
    </Component>

  </Package>
</Wix>
