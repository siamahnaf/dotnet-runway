<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Dotswitch</AssemblyName>
    <RootNamespace>Dotswitch</RootNamespace>
    <!-- Its own identity in the Windows taskbar rather than grouping under a host app. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>dotswitch.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- The WebView2 package ships a WPF assembly we never load; it drags in a
         WindowsBase it cannot reconcile with the WinForms one. Harmless here. -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="System.Management" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="wwwroot\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- ApplicationIcon only embeds the icon in the exe; the window loads the
         file at runtime to get every size, so it has to be deployed too. -->
    <None Update="dotswitch.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
